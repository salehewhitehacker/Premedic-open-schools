    <script>
        // --- 1. Data Flow Particle Visuals ---
        const canvas = document.getElementById('data-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        class P {
            constructor() { this.r(); }
            r() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.s = Math.random() * 2 + 1;
                this.vx = (Math.random() - 0.5) * 2;
                this.vy = (Math.random() - 0.5) * 2;
            }
            u() {
                this.x += this.vx; this.y += this.vy;
                if(this.x<0 || this.x>canvas.width || this.y<0 || this.y>canvas.height) this.r();
            }
            d() {
                ctx.fillStyle = '#3b82f6';
                ctx.beginPath(); ctx.arc(this.x, this.y, this.s, 0, Math.PI*2); ctx.fill();
            }
        }
        function init() { for(let i=0; i<100; i++) particles.push(new P()); }
        function loop() {
            ctx.clearRect(0,0,canvas.width, canvas.height);
            particles.forEach(p => { p.u(); p.d(); });
            requestAnimationFrame(loop);
        }
        window.addEventListener('resize', resize); resize(); init(); loop();

        // --- 2. Security & Admin Panel ---
        let attempts = parseInt(localStorage.getItem('st_attempts')) || 0;
        let isLocked = localStorage.getItem('st_locked') === 'true';

        if(isLocked) document.getElementById('lockScreen').style.display = 'flex';

        function openAdmin() { if(!isLocked) document.getElementById('adminModal').classList.remove('hidden'); }
        function closeAdmin() { document.getElementById('adminModal').classList.add('hidden'); }

        function checkAdmin() {
            const u = document.getElementById('admUser').value;
            const p = document.getElementById('admPass').value;
            const err = document.getElementById('loginError');

            if(u === "Salehe" && p === "5050") {
                document.getElementById('adminPanel').classList.remove('hidden');
                document.getElementById('adminModal').classList.add('hidden');
                attempts = 0; localStorage.setItem('st_attempts', 0);
                showUsers();
            } else {
                attempts++;
                localStorage.setItem('st_attempts', attempts);
                err.innerText = `Ingia iliyokataliwa! Majaribio yaliyobaki: ${3 - attempts}`;
                err.classList.remove('hidden');
                if(attempts >= 3) {
                    localStorage.setItem('st_locked', 'true');
                    document.getElementById('lockScreen').style.display = 'flex';
                }
            }
        }

        // --- 3. Data Storage & Rendering ---
        function submitForm(e) {
            e.preventDefault();
            const data = {
                name: document.getElementById('fname').value,
                email: document.getElementById('femail').value,
                city: document.getElementById('fcity').value,
                phone: document.getElementById('fphone').value,
                whatsapp: document.getElementById('fwhatsapp').value,
                plan: document.getElementById('fplan').value,
                date: new Date().toLocaleString()
            };
            
            let users = JSON.parse(localStorage.getItem('st_users')) || [];
            users.push(data);
            localStorage.setItem('st_users', JSON.stringify(users));

            // Formspree connection
            const fd = new FormData();
            Object.keys(data).forEach(k => fd.append(k, data[k]));
            fetch("https://formspree.io/f/shabaniomary802@gmail.com", { method: 'POST', body: fd, headers: {'Accept': 'application/json'}})
            .then(() => { alert("Asante " + data.name + "! Wataalam wetu wameshapokea taarifa zako."); e.target.reset(); });
        }

        function showUsers() {
            const area = document.getElementById('userDataArea');
            const users = JSON.parse(localStorage.getItem('st_users')) || [];
            area.innerHTML = "<h3 class='text-2xl font-bold mb-8'>Wateja Waliopo</h3>";
            if(users.length === 0) area.innerHTML += "<p class='text-gray-500'>Bado hakuna wateja.</p>";
            
            users.reverse().forEach(u => {
                area.innerHTML += `
                    <div class="glass p-6 rounded-3xl mb-4 border-l-4 border-blue-500">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <p class="text-xl font-bold">${u.name}</p>
                      
